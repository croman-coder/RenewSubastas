# Copiar a `.env` al lado del docker-compose.server.yml.
#
# Postgres destino. En el servidor, srpy-postgres escucha en 127.0.0.1:5433
# desde el host y en srpy-postgres:5432 desde la red infra_default.
MIRROR_DATABASE_URL=postgres://renew_mirror:CAMBIAR@srpy-postgres:5432/renewsubastas_mirror

# Local, contra emuladores (ver README):
# MIRROR_DATABASE_URL=postgres://mirror:mirror@127.0.0.1:5439/renew_mirror
# MIRROR_PROJECT_ID=carbid-staging
# MIRROR_STORAGE_BUCKET=carbid-staging.appspot.com
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
