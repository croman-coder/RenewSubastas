{
  "name": "@carbid/mirror",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Espejo continuo de Firebase (Firestore + Auth + Storage) hacia PostgreSQL en el servidor SRPY186. Sólo lectura contra Firebase.",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "sync:full": "tsx src/cli.ts full",
    "sync:auth": "tsx src/cli.ts auth",
    "sync:storage": "tsx src/cli.ts storage",
    "verify": "tsx src/cli.ts verify"
  },
  "dependencies": {
    "firebase-admin": "^12.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
}
