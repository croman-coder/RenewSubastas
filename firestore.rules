rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isSignedIn() { return request.auth != null; }
    function isActive()   { return request.auth.token.status == 'active'; }
    function role()       { return request.auth.token.role; }
    function isAdmin()    { return isSignedIn() && isActive() && role() == 'admin'; }
    function isStaff()    { return isSignedIn() && isActive() && role() == 'staff'; }
    function isFinanzas() { return isSignedIn() && isActive() && role() == 'finanzas'; }
    function isBuyer()    { return isSignedIn() && isActive() && role() == 'buyer'; }
    // Buyer-only catalog segment ('retail' | 'wholesale'). Defaults to 'retail'
    // for legacy buyers whose claim hasn't been refreshed yet.
    function audience()   { return request.auth.token.audience != null ? request.auth.token.audience : 'retail'; }
    // True when the document's audience matches the calling buyer's audience.
    // A missing audience field (legacy data) is treated as 'retail' — NOT as
    // "visible to everyone"; `docAudience == null` must resolve to a value
    // that's compared, never short-circuit to an open true.
    function audienceMatches(docAudience) {
      return (docAudience == null ? 'retail' : docAudience) == audience();
    }

    match /users/{uid} {
      // Admin sees all; everyone reads their own. Finanzas no longer reads
      // user docs directly — it would otherwise expose every user's PII
      // (documentNumber, email, phone). Winner contact for the sales ledger
      // is resolved through the `getWinnerContact` Cloud Function, which
      // returns only name + email + phone and only for an actual winner.
      allow read:   if isAdmin() || request.auth.uid == uid;
      // Allowlist (fail-closed): from the client a user may only change
      // `favorites` (the favorite-toggle). Everything else on the user doc —
      // role, status, createdBy, profile, audience, fcmTokens, preferences,
      // and any field added in the future — is server-managed and written via
      // the Admin SDK (which bypasses rules). Because the allowlist names only
      // the safe field, no privileged field can be tampered with from the
      // client, and new sensitive fields are protected automatically.
      allow update: if request.auth.uid == uid
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['favorites']);
      allow create, delete: if false;
    }

    match /vehicles/{id} {
      // Admin/staff/finanzas see every vehicle; buyers only their audience,
      // and only once it's actually publishable — 'draft'/'ready' are staff
      // still preparing the listing (photos, pricing) before it goes live,
      // and 'archived' was pulled from the catalog. No buyer client code
      // reads vehicles/{id} directly before the auction is live anyway (the
      // buyer-facing pages load through server-side Admin SDK loaders keyed
      // off the auction, not the vehicle), so this only closes a gap for a
      // client hitting this doc directly.
      allow read: if isAdmin()
                  || isStaff()
                  || isFinanzas()
                  || (isBuyer()
                      && audienceMatches(resource.data.audience)
                      && resource.data.status in ['in_auction', 'sold']);
      allow create, update: if isStaff() || isAdmin();
      allow delete:         if isStaff() || isAdmin();
    }

    match /auctions/{id} {
      allow read: if isAdmin()
                  || isStaff()
                  || isFinanzas()
                  || (isBuyer() && audienceMatches(resource.data.audience));
      allow create, update, delete: if false;

      match /bids/{bidId} {
        // Bid history follows the auction's audience. Firestore evaluates each
        // rule independently, so we actually re-apply the audience guard here
        // by reading the parent auction's `audience` — without this a retail
        // buyer could read wholesale bid history (amounts + bidder uids) and
        // vice-versa. Admin/staff see all.
        allow read: if isAdmin()
                    || isStaff()
                    || (isBuyer()
                        && audienceMatches(
                             get(/databases/$(db)/documents/auctions/$(id)).data.audience));
        allow create, update, delete: if false;
      }

      // Insights subcollections: who viewed the auction and how prices moved.
      // Internal eyes only — buyers must never see who else is watching a car
      // or the pricing history. Writes are Admin SDK only (Cloud Functions).
      match /viewers/{viewerUid} {
        allow read: if isAdmin() || isStaff();
        allow create, update, delete: if false;
      }
      match /priceChanges/{changeId} {
        allow read: if isAdmin() || isStaff();
        allow create, update, delete: if false;
      }

      // Money fields with no legitimate buyer-facing use (reservePrice today).
      // Firestore has no field-level read control — putting reservePrice on
      // the parent auction doc meant every buyer's onSnapshot on that doc
      // received it, letting a bidder stop exactly at the reserve and never
      // a cent above. Split onto a doc only admin/staff/finanzas can read.
      match /private/{docId} {
        allow read: if isAdmin() || isStaff() || isFinanzas();
        allow create, update, delete: if false;
      }
    }

    // Collection group rule: enables collectionGroup('bids') queries (used by
    // the staff/admin/finanzas notification bell to surface every new bid
    // across all auctions in real time). Restricted to internal roles only — a
    // buyer has no need to read bids across all auctions, and allowing it would
    // leak the other audience's bid history (the wildcard can't cheaply
    // re-check each parent's audience). Buyers read bids per-auction via the
    // rule above, which does re-check audience.
    match /{path=**}/bids/{bidId} {
      allow read: if isAdmin() || isStaff() || isFinanzas();
    }

    // Holds operational config INCLUDING the company's real bank account
    // details (payment.bankAccountNumber/bankRuc/bankAccountHolder, used by
    // sendAuctionWon to tell a winner where to wire the deposit). The old
    // "any signed-in active user" rule let every buyer read this doc
    // directly via the client SDK — no auction win required. No client code
    // reads app_config directly at all (every consumer goes through a
    // server-side Admin SDK loader), so this only closes that gap.
    match /app_config/{doc} {
      allow read:  if isAdmin() || isStaff() || isFinanzas();
      allow write: if false;
    }

    // Anonymous web-traffic counter
    // (docs/superpowers/specs/2026-08-08-trafico-web-design.md). Raw
    // per-visit events: one doc per page view, auto-id'd, written only by
    // the logPageView Cloud Function (Admin SDK bypasses rules — it has no
    // requireSignedIn call on purpose, since anonymous visitors are the
    // entire point). No client of any role — buyer, staff, or admin — ever
    // reads or writes this collection directly; /staff/insights reads the
    // rolled-up aggregate below instead. Deny both directions explicitly
    // rather than relying on the implicit default-deny, same reasoning as
    // password_set_tokens and rate_limits above.
    match /page_views/{id} {
      allow read, write: if false;
    }

    // Daily rollup of page_views (yesterday's Paraguay-local day), written
    // only by the aggregateTraffic scheduler (Admin SDK). Read access
    // mirrors app_config just above: admin/staff/finanzas can see traffic
    // numbers, buyers never can — there is nothing buyer-specific in here,
    // just site-wide counts.
    match /insights_traffic_daily/{date} {
      allow read:  if isAdmin() || isStaff() || isFinanzas();
      allow write: if false;
    }

    match /audit_logs/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // Email notification log (te-superaron / ganaste). Written only by the
    // server (Admin SDK bypasses rules); read by admin/staff for the Pujas
    // panel. Holds toEmail, so it stays off-limits to buyers/finanzas.
    match /notifications/{id} {
      allow read:  if isAdmin() || isStaff();
      allow write: if false;
    }

    // Password reset requests: only admins can read or update the queue;
    // creation is restricted to the requestPasswordReset Cloud Function
    // (rate-limited and identity-checked there).
    match /password_reset_requests/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // Self-issued password-set tokens. Only the Admin SDK (Cloud Functions)
    // ever touches these; clients have no access at all, so a leaked token
    // hash can't be read or forged from the browser.
    match /password_set_tokens/{id} {
      allow read, write: if false;
    }

    // Rate-limit counters (pwreset_*, views_*, paymentproof_*, ...), Admin
    // SDK only. Already denied by the implicit default-deny (nothing above
    // matches this path), but made explicit since several Cloud Functions
    // now write here — a reader shouldn't have to reason about "nothing
    // mentions it" to know a client can't read or tamper with its own
    // rate-limit window.
    match /rate_limits/{id} {
      allow read, write: if false;
    }
  }
}
