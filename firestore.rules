rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isSignedIn() { return request.auth != null; }
    function isActive()   { return request.auth.token.status == 'active'; }
    function role()       { return request.auth.token.role; }
    function isAdmin()    { return isSignedIn() && isActive() && role() == 'admin'; }
    function isStaff()    { return isSignedIn() && isActive() && role() == 'staff'; }
    function isBuyer()    { return isSignedIn() && isActive() && role() == 'buyer'; }
    // Buyer-only catalog segment ('retail' | 'wholesale'). Defaults to 'retail'
    // for legacy buyers whose claim hasn't been refreshed yet.
    function audience()   { return request.auth.token.audience != null ? request.auth.token.audience : 'retail'; }
    // True when the document's audience matches the calling buyer's audience,
    // OR when the doc has no audience field (legacy data, treated as retail).
    function audienceMatches(docAudience) {
      return docAudience == null || docAudience == audience();
    }

    match /users/{uid} {
      allow read:   if isAdmin() || request.auth.uid == uid;
      // A user editing their own doc cannot change any of the privileged
      // fields. `role` and `status` gate access; `createdBy` is an audit
      // anchor; `profile.audience` decides which catalog they can see (a
      // retail buyer could otherwise self-promote to wholesale and read
      // the opposite segment). All four must stay equal to their previous
      // value — checked with the explicit-equality pattern so missing
      // fields can't be used to bypass the check.
      allow update: if request.auth.uid == uid
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.status == resource.data.status
                    && request.resource.data.createdBy == resource.data.createdBy
                    // Use the map-of-keys trick so this also blocks deletes
                    // of the audience field (a delete would set the
                    // post-write value to undefined and bypass an equality
                    // check). `get(...).audience` returns null when the
                    // field doesn't exist on either side, so legacy users
                    // without profile.audience can still update other
                    // fields freely.
                    && request.resource.data.get(['profile', 'audience'], null)
                       == resource.data.get(['profile', 'audience'], null)
                    // `fcmTokens` is written only by the savePushToken
                    // callable (which runs with admin SDK and bypasses
                    // rules). A buyer cannot read or modify it from the
                    // client — leaks would expose every device the user
                    // has registered for push.
                    && request.resource.data.get('fcmTokens', null)
                       == resource.data.get('fcmTokens', null);
      allow create, delete: if false;
    }

    match /vehicles/{id} {
      // Admin/staff see every vehicle; buyers only see their audience.
      allow read: if isAdmin()
                  || isStaff()
                  || (isBuyer() && audienceMatches(resource.data.audience));
      allow create, update: if isStaff() || isAdmin();
      allow delete:         if isStaff() || isAdmin();
    }

    match /auctions/{id} {
      allow read: if isAdmin()
                  || isStaff()
                  || (isBuyer() && audienceMatches(resource.data.audience));
      allow create, update, delete: if false;

      match /bids/{bidId} {
        // Bid history of an auction follows the auction's read rule via the
        // parent's audience, but Firestore evaluates each rule independently
        // so we replicate the audience guard against the parent doc here.
        allow read: if isAdmin() || isStaff() || isBuyer();
        allow create, update, delete: if false;
      }
    }

    // Collection group rule: enables collectionGroup('bids') queries (used
    // by the admin/staff notification bell to surface every new bid across
    // all auctions in real time). Without this wildcard, Firestore rejects
    // collection group reads even though the per-document rule allows them.
    match /{path=**}/bids/{bidId} {
      allow read: if isSignedIn() && isActive();
    }

    match /app_config/{doc} {
      allow read:  if isSignedIn() && isActive();
      allow write: if false;
    }

    match /audit_logs/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // Password reset requests: only admins can read or update the queue;
    // creation is restricted to the requestPasswordReset Cloud Function
    // (rate-limited and identity-checked there).
    match /password_reset_requests/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }
  }
}
