rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Vehicle photos. Any active signed-in user can read; audience
    // scoping is enforced in the application layer (Firestore queries
    // filter vehicles/auctions by `audience`, so a wholesale buyer
    // can never reach a retail vehicle's detail page in the first
    // place). Doing the audience check here too would require a
    // firestore.get() per read, which is fragile against vehicles
    // that don't yet have a Firestore doc (the upload flow generates
    // the vehicleId client-side and uploads photos before the doc
    // exists). Writes stay locked to admin/staff with size and
    // content-type caps.
    match /vehicles/{vehicleId}/{file=**} {
      allow read:  if request.auth != null
                   && request.auth.token.status == 'active';
      allow write: if request.auth != null
                   && request.auth.token.status == 'active'
                   && request.auth.token.role in ['staff', 'admin']
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Payment proofs (comprobantes de seña). A winning buyer uploads a
    // transfer receipt (image or PDF). Path is
    // payment-proofs/{auctionId}/{uid}-{ts}.{ext}. Write is allowed for
    // any active buyer writing under their OWN uid prefix; the
    // submitPaymentProof callable then validates that the uid is the
    // auction's actual winnerUid before emailing the admin. Reads are
    // admin/staff only (the receipt holds the buyer's bank info).
    match /payment-proofs/{auctionId}/{fileName} {
      allow read: if request.auth != null
                  && request.auth.token.status == 'active'
                  && request.auth.token.role in ['staff', 'admin', 'finanzas'];
      // Buyer may only write a file whose name starts with their own uid
      // (the client uploads `{uid}-{ts}.{ext}`). This stops one buyer from
      // overwriting another's proof or dumping files into someone else's
      // auction folder. submitPaymentProof still verifies winnerUid.
      allow write: if request.auth != null
                   && request.auth.token.status == 'active'
                   && request.auth.token.role == 'buyer'
                   && fileName.matches(request.auth.uid + '-.*')
                   && request.resource.size < 10 * 1024 * 1024
                   && (
                     request.resource.contentType.matches('image/.*')
                     || request.resource.contentType == 'application/pdf'
                   );
    }

    // Avatars are intentionally world-readable so they can appear in
    // notification cards and audit-log rows without a signed-URL
    // dance. The upload side is locked to the avatar's owner, capped
    // at 2 MB so the bucket can't be used as anonymous file hosting.
    match /avatars/{uid}/{file=**} {
      allow read:  if true;
      allow write: if request.auth != null
                   && request.auth.token.status == 'active'
                   && request.auth.uid == uid
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
