rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Vehicle photos. Any active signed-in user can read; audience
    // scoping is enforced in the application layer (Firestore queries
    // filter vehicles/auctions by `audience`, so a wholesale buyer
    // can never reach a retail vehicle's detail page in the first
    // place). Doing the audience check here too would require a
    // firestore.get() per read, which is fragile against vehicles
    // that don't yet have a Firestore doc (the upload flow generates
    // the vehicleId client-side and uploads photos before the doc
    // exists). Writes stay locked to admin/staff with size and
    // content-type caps.
    match /vehicles/{vehicleId}/{file=**} {
      allow read:  if request.auth != null
                   && request.auth.token.status == 'active';
      allow write: if request.auth != null
                   && request.auth.token.status == 'active'
                   && request.auth.token.role in ['staff', 'admin']
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Payment proofs (comprobantes de seña). A winning buyer uploads a
    // transfer receipt (image or PDF). Path is
    // payment-proofs/{auctionId}/{uid}/{fileName} — uid is a real path
    // segment (bound by the `{uid}` wildcard below), not a string-matched
    // filename prefix, so there's no regex-escaping concern and no way to
    // land a file under another buyer's segment of the same auction folder.
    // Reads are admin/staff/finanzas only (el comprobante lleva los datos
    // bancarios del comprador). create-only: un comprobante enviado es
    // evidencia y no se puede pisar ni borrar después de que staff lo vio.
    //
    // NO agregar acá un firestore.get() del winnerUid sin conceder antes el
    // permiso IAM que eso necesita. Hubo una versión que lo hacía, desplegada
    // el 5 de agosto, y desde entonces NINGÚN comprobante se pudo subir: las
    // reglas de Storage que leen Firestore son una llamada entre servicios y
    // requieren que el agente de servicio
    // `service-<proyecto>@gcp-sa-firebasestorage.iam.gserviceaccount.com`
    // tenga el rol `roles/firebaserules.firestoreServiceAgent`. En este
    // proyecto no lo tiene, así que la llamada fallaba y la regla denegaba
    // todo con `storage/unauthorized` — un error que no distingue "no tenés
    // permiso" de "la regla no pudo evaluarse".
    //
    // Costó una venta: el ganador de oMPocSwsIOn1lnsInRzg no pudo adjuntar la
    // transferencia, se le venció el plazo y el sistema le liberó la
    // adjudicación.
    //
    // Lo que queda protegiendo esto sin salir del bucket:
    //   - `request.auth.uid == uid` encierra a cada comprador en su propia
    //     carpeta; nadie puede escribir bajo el segmento de otro.
    //   - la lectura sigue siendo sólo staff/admin/finanzas.
    //   - submitPaymentProof verifica winnerUid antes de hacer nada con el
    //     archivo, que es lo que siempre lo hizo y sigue haciéndolo.
    // Lo que se pierde: un comprador activo podría dejar un archivo bajo su
    // propio uid en una subasta que no ganó. Nadie lo ve nunca y está acotado
    // por los topes de tamaño y tipo — basura en el bucket, no una fuga.
    //
    // Para recuperar la comprobación fuerte hay que conceder ese rol IAM
    // primero y recién después volver a poner el firestore.get().
    match /payment-proofs/{auctionId}/{uid}/{fileName} {
      allow read: if request.auth != null
                  && request.auth.token.status == 'active'
                  && request.auth.token.role in ['staff', 'admin', 'finanzas'];
      allow create: if request.auth != null
                    && request.auth.token.status == 'active'
                    && request.auth.token.role == 'buyer'
                    && request.auth.uid == uid
                    && request.resource.size < 10 * 1024 * 1024
                    && (
                      request.resource.contentType.matches('image/.*')
                      || request.resource.contentType == 'application/pdf'
                    );
      allow update, delete: if false;
    }
  }
}
